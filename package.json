{
  "name": "duitku",
  "version": "0.1.0",
  "private": true,
  "description": "Personal finance tracker with Gmail auto-sync for Indonesian platforms",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "cd packages/shared && npm run build",
    "build:api": "cd workers/api && npm run build",
    "dev:api": "cd workers/api && npm run dev",
    "dev:mobile": "cd apps/mobile && npm start",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json",
    "typecheck:mobile": "cd apps/mobile && npx tsc --noEmit",
    "typecheck:all": "npm run typecheck && cd workers/api && npx tsc --noEmit && cd ../../apps/mobile && npx tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "expo-linear-gradient": "^55.0.10-canary-20260328-2049187",
    "react-dom": "^19.0.0",
    "react-native-worklets": "^0.8.1"
  }
}
